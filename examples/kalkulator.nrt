pisz("=== KALKULATOR NURT ===")
pisz("Podaj pierwsza liczbe: ")
bierz() -> #l1
pisz("Podaj druga liczbe: ")
bierz() -> #l2

pisz("Wybierz operacje (1-dodawanie, 2-odejmowanie, 3-mnozenie, 4-dzielenie): ")
bierz() -> #operacja

?operacja == 1 ?
| prawda =>:
    pisz("Wynik: ", #l1 + #l2)
| falsz =>:
    ?operacja == 2 ?
    | prawda =>:
        pisz("Wynik: ", #l1 - #l2)
    | falsz =>:
        ?operacja == 3 ?
        | prawda =>:
            pisz("Wynik: ", #l1 * #l2)
        | falsz =>:
            ?operacja == 4 ?
            | prawda =>:
                pisz("Wynik: ", #l1 / #l2)
            | falsz =>:
                pisz("Nieznana operacja!")
            koniec
        koniec
    koniec
koniec