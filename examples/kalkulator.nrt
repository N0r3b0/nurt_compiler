# kalkulator.nrt - prosty kalkulator zbudowany na instrukcji 'dopasuj'.
# Demonstrates: string matching (strcmp chain), int matching (cmp/je chain),
# the mandatory 'inaczej' branch, return path coverage through 'dopasuj',
# and the keyword logical operators 'i' / 'lub'.

powolaj oblicz(#a, $op, #b) -> #:
    dopasuj $op
    | "+" =>:
        <- #a + #b
    | "-" =>:
        <- #a - #b
    | "*" =>:
        <- #a * #b
    | "/" =>:
        #b == 0 ?
        | prawda =>:
            pisz("blad: dzielenie przez zero\n")
            <- 0
        | falsz =>:
            <- #a / #b
        koniec
    | "%" =>:
        <- #a % #b
    | inaczej =>:
        pisz("nieznany operator: ", $op, "\n")
        <- 0
    koniec
koniec

pisz("podaj pierwsza liczbe: ")
bierz() -> #a
pisz("podaj operator (+ - * / %): ")
bierz() -> $op
pisz("podaj druga liczbe: ")
bierz() -> #b

oblicz(#a, $op, #b) -> #wynik
pisz(#a, " ", $op, " ", #b, " = ", #wynik, "\n")

# Komentarz do wyniku: dopasowanie na liczbie.
dopasuj #wynik
| 0 =>:
    pisz("wynik zerowy\n")
| 42 =>:
    pisz("odpowiedz na wszystko!\n")
| inaczej =>:
    #wynik > 0 i #wynik % 2 == 0 ?
    | prawda =>:
        pisz("wynik dodatni i parzysty\n")
    | falsz =>:
        pisz("wynik ujemny lub nieparzysty\n")
    koniec
koniec
